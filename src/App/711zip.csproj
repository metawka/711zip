<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Zip711</RootNamespace>
    <!-- Assembly identifier must not start with a digit (breaks the CsWinRT AOT
         source generator). The user-facing "711zip.exe" is produced by renaming
         the apphost at dist time; product/window branding stays "711zip". -->
    <AssemblyName>Zip711</AssemblyName>
    <Product>711zip</Product>
    <AssemblyTitle>711zip</AssemblyTitle>
    <Company>metawka</Company>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <Description>Windows 11-style front end for 7-Zip</Description>
    <Copyright>Copyright (C) 2026 metawka</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>

  <!-- Bundle the 7-Zip engine next to the app -->
  <ItemGroup>
    <None Include="..\..\vendor\engine-x64\7z.dll" Link="engine\7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\engine-x64\7z.exe" Link="engine\7z.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- App icon available at runtime for the window/taskbar -->
  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
