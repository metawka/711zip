<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zip711.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Zip711.Models">

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag region only; caption buttons live to the right) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xF012;" FontSize="15"
                      VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="711zip" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
        </Grid>

        <!-- Command bar -->
        <Grid Grid.Row="1" Padding="10,4,10,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="OnBack" Padding="9,6"
                        ToolTipService.ToolTip="Назад" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="UpButton" Click="OnUp" Padding="9,6"
                        ToolTipService.ToolTip="Вверх" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Path -->
            <TextBox Grid.Column="2" x:Name="PathBox" Margin="6,0,6,0"
                     VerticalAlignment="Center" KeyDown="OnPathKeyDown"
                     PlaceholderText="Введите путь и нажмите Enter" />

            <!-- Primary actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="FavButton" Click="OnOpenFavorites" Padding="10,6" ToolTipService.ToolTip="Избранное">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="#FFC83F" />
                        <TextBlock Text="Избранное" />
                    </StackPanel>
                </Button>
                <Button x:Name="CompressButton" Click="OnCompress" Padding="10,6" IsEnabled="False"
                        ToolTipService.ToolTip="Добавить в архив">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Добавить" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExtractButton" Click="OnExtract" Padding="10,6" IsEnabled="False"
                        Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Извлечь">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8DE;" FontSize="14" />
                        <TextBlock Text="Извлечь" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Utility -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button x:Name="RefreshButton" Click="OnRefresh" Padding="9,6"
                        ToolTipService.ToolTip="Обновить" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="ThemeButton" Click="OnToggleTheme" Padding="9,6"
                        ToolTipService.ToolTip="Сменить тему" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="ThemeGlyph" Glyph="&#xE706;" FontSize="14" />
                </Button>
                <Button x:Name="SettingsButton" Click="OnOpenSettings" Padding="9,6"
                        ToolTipService.ToolTip="Настройки" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="InfoButton" Click="OnAbout" Padding="9,6"
                        ToolTipService.ToolTip="О программе 711zip" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="2" x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />

        <!-- Column header + list -->
        <Grid Grid.Row="3" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="20,6,20,6" ColumnSpacing="12"
                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Имя" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="Размер" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="Изменён" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ListView Grid.Row="1" x:Name="FileList"
                      ItemsSource="{x:Bind Items}"
                      SelectionMode="Extended"
                      DoubleTapped="OnItemActivated"
                      IsDoubleTapEnabled="True"
                      RightTapped="OnListRightTapped"
                      AllowDrop="True"
                      CanDragItems="True"
                      CanReorderItems="False"
                      DragItemsStarting="OnDragItemsStarting"
                      DragOver="OnListDragOver"
                      Drop="OnListDrop">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="MinHeight" Value="34" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Grid ColumnSpacing="12" Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Padding="20,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
