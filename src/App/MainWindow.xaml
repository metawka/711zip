<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zip711.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Zip711.Models">

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xF012;" FontSize="16"
                      VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="711zip" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <Button Grid.Column="3" x:Name="ThemeButton" Click="OnToggleTheme"
                    Background="Transparent" BorderThickness="0" Width="46" Height="32"
                    Margin="0,0,4,0" ToolTipService.ToolTip="Сменить тему">
                <FontIcon x:Name="ThemeGlyph" Glyph="&#xE706;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Command bar -->
        <Grid Grid.Row="1" Padding="12,4,12,4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="OnBack"
                    ToolTipService.ToolTip="Назад" Padding="10,6">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button Grid.Column="1" x:Name="UpButton" Click="OnUp"
                    ToolTipService.ToolTip="Вверх" Padding="10,6">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <TextBox Grid.Column="2" x:Name="PathBox" Margin="6,0,0,0"
                     IsReadOnly="True" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="ExtractButton" Click="OnExtract" Padding="12,6"
                        Style="{ThemeResource AccentButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8DE;" FontSize="14" />
                        <TextBlock Text="Распаковать" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="OnRefresh" Padding="10,6"
                        ToolTipService.ToolTip="Обновить">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="2" x:Name="Busy" IsIndeterminate="True"
                     Visibility="Collapsed" Margin="0,0,0,0" />

        <!-- Column header -->
        <Grid Grid.Row="3" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="20,6,20,6" ColumnSpacing="12"
                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Имя" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="Размер" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="Изменён" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ListView Grid.Row="1" x:Name="FileList"
                      ItemsSource="{x:Bind Items}"
                      SelectionMode="Extended"
                      DoubleTapped="OnItemActivated"
                      IsDoubleTapEnabled="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="MinHeight" Value="36" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Grid ColumnSpacing="12" Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Padding="20,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
