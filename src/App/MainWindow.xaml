<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zip711.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xF012;" FontSize="16"
                      VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="711zip" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <Button Grid.Column="3" x:Name="ThemeButton" Click="OnToggleTheme"
                    Background="Transparent" BorderThickness="0" Width="46" Height="32"
                    Margin="0,0,4,0" ToolTipService.ToolTip="Тема">
                <FontIcon x:Name="ThemeGlyph" Glyph="&#xE706;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xF012;" FontSize="48"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="711zip" HorizontalAlignment="Center"
                           Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock x:Name="EngineStatus" HorizontalAlignment="Center"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
